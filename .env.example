# Copy to .env. Local dev database from docker-compose.yml.
DATABASE_URL="postgresql://kopa:kopa@localhost:5432/kopa?schema=public"

# Exchange rate used for limits until a live FX feed exists (KES per USD).
KES_PER_USD=129
# Salt for hashing member phone numbers and national IDs. Use a long random value outside dev.
PII_HASH_SALT="dev-only-salt"

# Sign-in. Generate with: openssl rand -base64 48
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
# 1 = show the account switcher and dev outbox (never in production).
DEV_LOGIN=1
# Production messaging (leave empty in development to use the dev outbox).
RESEND_API_KEY=
EMAIL_FROM=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
