# Copy to .env. Local dev database from docker-compose.yml.
DATABASE_URL="postgresql://kopa:kopa@localhost:5432/kopa?schema=public"

# Exchange rate used for limits until a live FX feed exists (KES per USD).
KES_PER_USD=129
# Salt for hashing member phone numbers and national IDs. Use a long random value outside dev.
PII_HASH_SALT="dev-only-salt"
