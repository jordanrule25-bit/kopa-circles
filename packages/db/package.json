{
  "name": "@kopa/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kopa/core": "workspace:*",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0"
  }
}
