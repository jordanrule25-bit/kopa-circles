{
  "name": "@kopa/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "dotenv -e ../../.env -- vitest run",
    "create-admin": "dotenv -e ../../.env -- tsx src/create-admin.ts",
    "create-admin:prod": "tsx src/create-admin.ts",
    "postinstall": "prisma generate",
    "migrate:deploy:ci": "prisma migrate deploy"
  },
  "dependencies": {
    "@kopa/core": "workspace:*",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "^6.19.0",
    "@vercel/functions": "^3.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "vitest": "^5.0.5"
  }
}
