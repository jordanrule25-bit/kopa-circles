{
  "name": "kopa-circles",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:up": "docker compose up -d --wait",
    "db:generate": "pnpm --filter @kopa/db db:generate",
    "db:migrate": "pnpm --filter @kopa/db migrate",
    "db:seed": "pnpm --filter @kopa/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
